{
  "version": 2,
  "name": "Petstore code mock",
  "workspace": "<workspaceId>",
  "mockId": null,
  "source": { "spec": "./petstore.yaml" },
  "stateful": false,
  "realBaseUrl": "",
  "defaultMode": "mock",
  "activeFlow": "default",
  "flows": ["sold-out"],
  "apis": {
    "GET /v1/pets/:petId": {
      "flows": {
        "default": {
          "cases": [
            { "name": "not found", "when": { "params": { "petId": "999" } }, "response": { "status": 404, "body": { "code": "PET_NOT_FOUND" } } },
            { "name": "admin view", "when": { "headers": { "x-role": "admin" } }, "response": { "status": 200, "body": { "id": 1, "name": "Milo", "notes": "vet only" } } }
          ]
        },
        "sold-out": { "response": { "status": 200, "body": { "id": 7, "name": "Luna", "status": "sold" } } }
      }
    },
    "POST /v1/auth/login": {
      "flows": {
        "default": {
          "cases": [
            { "name": "locked", "when": { "body": { "email": "locked@example.com" } }, "response": { "status": 423, "delayMs": 300, "body": { "code": "ACCOUNT_LOCKED" } } }
          ]
        },
        "sold-out": { "enabled": false }
      }
    }
  }
}
