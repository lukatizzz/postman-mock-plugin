{
  "version": 2,
  "name": "Petstore mock",
  "source": { "collection": "<collection uid from mock-import>" },
  "basePath": "/v1",
  "defaultMode": "mock",
  "activeFlow": "default",
  "flows": ["sold-out"],
  "apis": {
    "GET /pets/:id": {
      "flows": {
        "default": {
          "cases": [
            { "name": "not found", "when": { "params": { "id": "999" } }, "response": { "status": 404, "body": { "code": "PET_NOT_FOUND" } } },
            { "name": "admin view", "when": { "headers": { "x-role": "admin" } }, "response": { "status": 200, "body": { "id": 1, "name": "Milo", "notes": "vet only" } } }
          ]
        },
        "sold-out": { "response": { "status": 200, "body": { "id": 7, "name": "Luna", "status": "sold" } } }
      }
    },
    "POST /auth/login": {
      "mode": "real",
      "flows": {
        "default": {
          "cases": [
            { "name": "locked", "when": { "body": { "email": "locked@example.com" } }, "response": { "status": 423, "delayMs": 300, "body": { "code": "ACCOUNT_LOCKED" } } }
          ]
        },
        "sold-out": { "enabled": false }
      }
    }
  }
}
